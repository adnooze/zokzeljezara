---
interface Props { size?: number; class?: string }
const { size = 120, class: cls = '' } = Astro.props;
const id = 'bl' + Math.random().toString(36).slice(2, 8);
---

<svg class={cls} width={size} height={size} viewBox="2.5 2.5 19 19" aria-hidden="true">
  <defs>
    <radialGradient id={id} cx="35%" cy="30%" r="75%">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.6" stop-color="#ffe6f0" />
      <stop offset="1" stop-color="#ff9ec8" />
    </radialGradient>
  </defs>
  <circle cx="12" cy="12" r="9" fill={`url(#${id})`} />
  <path d="M12 12a8 8 0 0 0 8 4 9 9 0 0 1-3.6 3.9A12 12 0 0 1 7.5 13.5 8 8 0 0 0 12 12z" fill="#ff2e8b" />
  <path d="M12 12a8 8 0 0 0-.54-8.93A9 9 0 0 1 16.5 4.2a12 12 0 0 1-.95 10.95A8 8 0 0 0 12 12z" fill="#e3242b" />
  <g fill="none" stroke="#2b0714" stroke-width="0.9" stroke-linecap="round">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 12a8 8 0 0 0 8 4" />
    <path d="M7.5 13.5a12 12 0 0 0 8.5 6.5" />
    <path d="M12 12a8 8 0 0 0-7.46 4.93" />
    <path d="M12.95 7.35a12 12 0 0 0-9.88 4.11" />
    <path d="M12 12a8 8 0 0 0-.54-8.93" />
    <path d="M15.55 15.15a12 12 0 0 0 1.38-10.61" />
  </g>
</svg>
