---
import Crest from './Crest.astro';
import Ball from './Ball.astro';
import { nadolazece, odigrane, inicijali } from '../data/klub';

const next = nadolazece[0];
const last = odigrane[odigrane.length - 1];
const lastHome = last.domaci ? 'ŽOK „Željezara“' : last.protivnik;
const lastAway = last.domaci ? last.protivnik : 'ŽOK „Željezara“';
const [lh, la] = (last.rezultat ?? '–:–').split(':');
---

<section class="gd" id="utakmica">
  <div class="echo" aria-hidden="true">
    {Array.from({ length: 7 }).map((_, i) => <span class="display" style={`--k:${i}`}>Game day</span>)}
  </div>

  <div class="wrap inner">
    <header class="head" data-reveal>
      <p class="eyebrow">Sljedeća utakmica · {next.kolo}. kolo</p>
      <h2 class="display big">
        <span>Game</span>
        <span class="pinkline">day</span>
      </h2>
    </header>

    <div class="cards">
      <article class="match" data-reveal="zoom" data-tilt="6">
        <div class="shine"></div>
        <div class="top">
          <span class="tag">{next.domaci ? 'Domaći teren' : 'Gostovanje'}</span>
          <span class="kolo display">{next.kolo}. kolo</span>
        </div>

        <div class="vs">
          <div class="team">
            {next.domaci ? <Crest size={110} /> : <span class="opp">{inicijali(next.protivnik)}</span>}
            <b>{next.domaci ? 'ŽOK „Željezara“' : next.protivnik}</b>
            <small>{next.domaci ? 'Zenica' : next.grad}</small>
          </div>
          <span class="v display">vs</span>
          <div class="team">
            {next.domaci ? <span class="opp">{inicijali(next.protivnik)}</span> : <Crest size={110} />}
            <b>{next.domaci ? next.protivnik : 'ŽOK „Željezara“'}</b>
            <small>{next.domaci ? next.grad : 'Zenica'}</small>
          </div>
        </div>

        <div class="meta">
          <div><span>Datum</span><b>{next.datum}</b></div>
          <div><span>Dvorana</span><b>{next.dvorana ?? next.grad}</b></div>
          <div><span>Početak</span><b>{next.vrijeme ?? 'Uskoro'}</b></div>
        </div>

        <div class="count" data-countdown={next.iso}>
          <p class="eyebrow">Do utakmičnog vikenda</p>
          <div class="digits">
            <div><b class="display" data-d>00</b><span>dana</span></div>
            <div><b class="display" data-h>00</b><span>sati</span></div>
            <div><b class="display" data-m>00</b><span>min</span></div>
            <div><b class="display" data-s>00</b><span>sek</span></div>
          </div>
        </div>
        <Ball size={90} class="ball" />
      </article>

      <article class="last" data-reveal="right" style="--d:.15s">
        <p class="eyebrow">Posljednji rezultat · {last.kolo}. kolo</p>
        <div class="score">
          <div class="row"><span>{lastHome}</span><b class="display">{lh}</b></div>
          <div class="row"><span>{lastAway}</span><b class="display">{la}</b></div>
        </div>
        {last.setovi && (
          <ul class="sets">
            {last.setovi.map((s) => <li>{s}</li>)}
          </ul>
        )}
        <p class="note">
          {last.datum} · {last.dvorana ?? last.grad}
        </p>
        <span class={`res res--${last.ishod ?? 'na'}`}>{last.ishod === 'pobjeda' ? 'Pobjeda' : last.ishod === 'poraz' ? 'Poraz' : 'Odigrano'}</span>
        <a href="#rezultati" class="more">Svi rezultati <span>→</span></a>
      </article>
    </div>
  </div>
</section>

<style>
  .gd {
    position: relative;
    background: var(--blush);
    color: var(--wine);
    padding: clamp(90px, 12vw, 150px) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .echo {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0;
    opacity: 0.55;
  }
  .echo span {
    font-size: clamp(5rem, 15vw, 13rem);
    line-height: 0.82;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--pink-soft);
    animation: breathe 6s ease-in-out infinite;
    animation-delay: calc(var(--k) * -0.6s);
  }
  @keyframes breathe { 50% { -webkit-text-stroke-color: var(--pink); opacity: 0.6; } }

  .inner { display: grid; gap: 40px; }
  .head { text-align: center; }
  .head .eyebrow { color: var(--red); }
  .big { font-size: clamp(5rem, 16vw, 12rem); color: var(--wine); display: flex; justify-content: center; gap: 0.12em; }
  .pinkline { color: var(--pink); position: relative; }

  .cards { display: grid; grid-template-columns: 1.6fr 1fr; gap: 26px; align-items: stretch; }

  .match {
    position: relative;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 28px;
    background: linear-gradient(150deg, var(--wine-3), var(--wine) 60%);
    color: var(--cream);
    overflow: hidden;
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.2s ease-out;
    box-shadow: 0 40px 80px -30px rgba(87, 17, 41, 0.6);
  }
  .shine {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--mx, 70%) var(--my, 20%), rgba(255, 46, 139, 0.45), transparent 45%);
    pointer-events: none;
  }
  .top { display: flex; justify-content: space-between; align-items: center; position: relative; }
  .kolo { font-size: 1.6rem; color: var(--pink-soft); }

  .vs { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; margin: 34px 0; }
  .team { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .team b { font-family: var(--f-display); font-weight: 400; font-size: clamp(1.1rem, 2.4vw, 1.6rem); text-transform: uppercase; line-height: 1.05; }
  .team small { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pink-soft); font-weight: 700; }
  .opp {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--f-display);
    font-size: 2.6rem;
    background: var(--cream);
    color: var(--wine);
    box-shadow: inset 0 0 0 6px var(--pink-soft);
  }
  .v { font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--pink); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { transform: scale(1.15); text-shadow: 0 0 30px var(--pink); } }

  .meta { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .meta div { padding: 12px 14px; border-radius: 14px; background: rgba(255, 247, 250, 0.07); border: 1px solid rgba(255, 184, 214, 0.15); }
  .meta span { display: block; font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--pink-soft); font-weight: 800; }
  .meta b { font-size: 0.95rem; }

  .count { position: relative; margin-top: 26px; }
  .count .eyebrow { color: var(--pink-soft); margin-bottom: 10px; }
  .digits { display: flex; gap: 10px; }
  .digits div { flex: 1; text-align: center; padding: 12px 6px; border-radius: 14px; background: var(--pink); color: #fff; }
  .digits b { display: block; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1; }
  .digits span { font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 800; }
  .match :global(.ball) { position: absolute; right: -20px; bottom: -20px; opacity: 0.18; animation: roll 10s linear infinite; }
  @keyframes roll { to { rotate: 360deg; } }

  .last {
    position: relative;
    padding: 30px;
    border-radius: 28px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 30px 60px -30px rgba(87, 17, 41, 0.35);
  }
  .last .eyebrow { color: var(--red); }
  .score { display: grid; gap: 8px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; background: var(--blush); }
  .row span { font-weight: 800; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.04em; }
  .row b { font-size: 2.4rem; line-height: 1; color: var(--wine); }
  .sets { display: flex; gap: 8px; flex-wrap: wrap; }
  .sets li { padding: 6px 12px; border-radius: 999px; border: 1.5px solid var(--pink-soft); font-weight: 800; font-size: 0.8rem; }
  .note { font-size: 0.85rem; opacity: 0.7; }
  .res { align-self: flex-start; padding: 6px 14px; border-radius: 999px; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .res--pobjeda { background: var(--pink); color: #fff; }
  .res--poraz { background: var(--wine); color: #fff; }
  .res--na { background: var(--blush); }
  .more { margin-top: auto; font-weight: 800; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.14em; color: var(--pink); display: inline-flex; gap: 8px; }
  .more span { transition: transform 0.3s var(--ease); }
  .more:hover span { transform: translateX(6px); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .opp, .vs :global(.crest) { width: 76px; height: 76px; font-size: 1.8rem; }
    .meta { grid-template-columns: 1fr; }
    .digits { gap: 6px; }
  }
</style>
