---
import Crest from './Crest.astro';
import { klub } from '../data/klub';
---

<section class="ko" id="kontakt">
  <div class="wrap grid">
    <div class="left">
      <p class="eyebrow pink" data-reveal>Budi dio priče</p>
      <h2 class="display" data-reveal style="--d:.08s">
        Voliš<br /><span class="pink">odbojku?</span><br /><span class="stroke">Javi se!</span>
      </h2>
      <p class="lead" data-reveal style="--d:.16s">
        Želiš igrati, podržati klub ili postati sponzor? Piši nam — odgovaramo na email i u Instagram poruke.
      </p>
    </div>

    <div class="panel" data-reveal="right" data-tilt="5">
      <Crest size={90} class="pc" />
      <dl>
        <div>
          <dt class="tag">Dvorana</dt>
          <dd>{klub.lokacije[0]}</dd>
        </div>
        <div>
          <dt class="tag">Lokacija</dt>
          <dd>{klub.lokacije[1]}</dd>
        </div>
        <div>
          <dt class="tag">Email</dt>
          <dd><a href={`mailto:${klub.email}`}>{klub.email}</a></dd>
        </div>
        <div>
          <dt class="tag">Instagram</dt>
          <dd><a href={klub.instagram} target="_blank" rel="noopener">@zok_zeljezara</a></dd>
        </div>
      </dl>
      <div class="actions">
        <a href={`mailto:${klub.email}`} class="btn">Pošalji email <span class="arr">→</span></a>
        <a href={klub.instagram} target="_blank" rel="noopener" class="btn btn--ghost">Prati nas</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ko {
    position: relative;
    padding: clamp(90px, 12vw, 150px) 0;
    background:
      radial-gradient(circle at 85% 30%, rgba(255, 46, 139, 0.35), transparent 40%),
      linear-gradient(170deg, var(--red-deep), var(--wine) 60%);
    overflow: hidden;
  }
  .grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 50px; align-items: center; }
  .left h2 { font-size: clamp(3.6rem, 9vw, 7.4rem); margin: 14px 0 22px; }
  .left .stroke { --sc: var(--cream); }
  .lead { max-width: 44ch; font-size: 1.05rem; opacity: 0.85; }

  .panel {
    position: relative;
    padding: 34px;
    border-radius: 28px;
    background: rgba(20, 3, 10, 0.55);
    border: 1px solid rgba(255, 184, 214, 0.2);
    backdrop-filter: blur(10px);
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
  }
  .panel :global(.pc) { position: absolute; top: -40px; right: 26px; animation: wobble 5s ease-in-out infinite; }
  @keyframes wobble { 50% { rotate: 10deg; translate: 0 -6px; } }
  dl { display: grid; gap: 18px; }
  dl div { display: grid; justify-items: start; gap: 6px; }
  dd { font-weight: 700; font-size: 1.1rem; word-break: break-word; }
  dd a { background: linear-gradient(var(--pink), var(--pink)) 0 100% / 0 2px no-repeat; transition: background-size 0.4s var(--ease); }
  dd a:hover { background-size: 100% 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 70px; }
    .panel { padding: 28px 22px; }
  }
</style>
